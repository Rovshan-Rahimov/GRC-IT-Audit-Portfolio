SELECT orders.order_id, orders.order_date, orders.total_amount 
FROM orders 
JOIN customers ON orders.customer_id = customers.customer_id 
WHERE customers.first_name = 'David';
---
SELECT 
    customer_id, 
    first_name, 
    last_name, 
    HEX(AES_ENCRYPT(phone, 'my_secret_key')) AS encrypted_phone 
FROM customers;
---
SELECT 
    customer_id, 
    phone AS original_phone,
    CAST(AES_DECRYPT(AES_ENCRYPT(phone, 'my_secret_key'), 'my_secret_key') AS CHAR) AS decrypted_phone
FROM customers;
---
SELECT 
    customer_id, 
    first_name, 
    last_name, 
    postal_code AS original_postal_code,
    CONCAT(REPEAT('*', LENGTH(postal_code) - 2), RIGHT(postal_code, 2)) AS masked_postal_code
FROM customers;
